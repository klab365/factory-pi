{
  "name": "pi-software-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "factory": "bun run src/cli.ts",
    "validate": "bun run src/cli.ts validate software-factory",
    "format": "biome format --write src tests",
    "check-format": "biome format src tests",
    "lint": "biome lint src tests",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run check-format && bun run lint && bun run test && bun run typecheck && bun run validate"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "typebox": "1.3.27",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
