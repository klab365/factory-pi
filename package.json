{
  "name": "pi-software-factory",
  "type": "module",
  "scripts": {
    "validate": "bun run scripts/validate-pipelines.ts",
    "format": "biome format --write src tests",
    "check-format": "biome format src tests",
    "lint": "biome lint src tests",
    "test": "bun test",
    "test:package": "bun run scripts/package-smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run check-format && bun run lint && bun run test && bun run typecheck && bun run validate",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "typebox": "1.3.27",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "^0.43.1",
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "astro": "^7.4.13",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0"
  },
  "version": "0.4.1",
  "description": "Pi extension for resumable project-local workflows",
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/klab365/factory-pi.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
